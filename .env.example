# Copy to .env and fill with real values. Never commit .env.
# Backend mode (mock = reproducible, no paid keys needed)
MOCK_AGENT=true
MOCK_EMAIL=true

# Real integrations (required only when MOCK_*=false)
OPENAI_API_KEY=
SERPAPI_API_KEY=
SENDGRID_API_KEY=

# Email defaults used by the original Streamlit app / real agent path
FROM_EMAIL=
TO_EMAIL=
EMAIL_SUBJECT=Travel Information

# Observability (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ai_travel_agent

# Backend / frontend wiring
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
VITE_GRAPHQL_URL=http://localhost:8000/graphql
